<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Range Scan"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enter CIDRs — found endpoints go to the backup list"
            android:textColor="@color/gray"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="CIDR (ကော်မာနဲ့ခွဲ)"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCidrs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/card"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Port (ကော်မာနဲ့ခွဲ)"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPorts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/card"
            android:fontFamily="monospace"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRangeScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/accent"
            android:text="Range စမယ်"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRangeProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/gray"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
